# 复制本文件为 .env 后按需填写本机值；.env 已被 Git 忽略，禁止提交真实 Token。
# PowerShell/系统进程环境变量优先于 .env 中的同名值。
# 金十 MCP 已从应用运行时和数据源注册表移除。
# 历史协议资料仅见 docs/jin10-mcp.md；这里不再提供可启用配置。

# `jin10_client` 是唯一对外的金十实时数据源。下面的 WEB/LOCAL 变量只配置其内部
# 采集适配器，不会创建两个可选数据源。
# 实时报价部分：官网公开结构化推送。0 表示按价格变化推送；不需要 Token。
JIN10_WEB_URL=wss://b-price.jin10.com/
JIN10_WEB_ORIGIN=https://www.jin10.com
JIN10_WEB_QUOTE_FREQUENCY_MS=0
JIN10_WEB_QUOTE_WAIT_TIMEOUT_SECONDS=5
JIN10_WEB_STALE_AFTER_SECONDS=12
JIN10_WEB_CONNECT_TIMEOUT_SECONDS=10

# 历史 K 线与日内补充部分：使用金十桌面会话鉴权。会话令牌属于密码凭据，
# 只能通过进程环境或被 Git 忽略的 .env/.env.local 提供，禁止提交、复制或输出。
# macOS 标准安装且已登录时留空即可从客户端 local_storage.json 自动发现 token。
# 行情协议由 token 解析账户，不读取客户端日志，也不需要用户编号。
# Windows、Linux 或非标准安装只需显式提供 SESSION_TOKEN。
JIN10_LOCAL_SESSION_TOKEN=
JIN10_LOCAL_URL=wss://app-quote-ws.jin10.com/
JIN10_LOCAL_KLINE_FILE_URL=https://jiaoyixia-market.jin10.com
JIN10_LOCAL_QUOTE_FREQUENCY_MS=1000
JIN10_LOCAL_KLINE_FREQUENCY_MS=3000
JIN10_LOCAL_QUOTE_WAIT_TIMEOUT_SECONDS=10
JIN10_LOCAL_KLINE_WAIT_TIMEOUT_SECONDS=12
JIN10_LOCAL_KLINE_DOWNLOAD_TIMEOUT_SECONDS=20
JIN10_LOCAL_STALE_AFTER_SECONDS=12
JIN10_LOCAL_CONNECT_TIMEOUT_SECONDS=10
JIN10_LOCAL_HEARTBEAT_SECONDS=10
JIN10_LOCAL_VIP_TYPE=3

# 可选。默认保存在项目 data/sources.json（该目录不会提交）。
TRACEFANG_SOURCE_CONFIG=
TRACEFANG_HOST=127.0.0.1
TRACEFANG_PORT=8000

# 可选。专家工作台默认先从 PATH 查找 Codex CLI；macOS 还会自动识别标准安装的
# ChatGPT.app。仅在非标准安装时填写 Codex 可执行文件的完整路径。
TRACEFANG_CODEX_CLI_PATH=

# 可选。留空时回放能力明确不可用；一旦配置，连接失败会阻止行情运行，避免形成
# 无标记的永久缺口。原始行情帧先经 JetStream 持久化确认，再进入协议解码；
# ReplayOriginal 由服务端按原始速率回放。默认滚动保留 7 天、最多 10 GiB，
# 时间或容量到限时推进 first_sequence 并淘汰最旧帧，始终保留最新帧。
TRACEFANG_NATS_URL=nats://127.0.0.1:14222
TRACEFANG_NATS_PORT=14222
TRACEFANG_NATS_MONITOR_PORT=18222
TRACEFANG_NATS_STREAM=MARKET_RAW_FRAMES
TRACEFANG_NATS_SUBJECT_PREFIX=market.raw
TRACEFANG_NATS_CONNECT_TIMEOUT_SECONDS=2
TRACEFANG_NATS_PUBLISH_TIMEOUT_SECONDS=2
TRACEFANG_NATS_MAX_AGE_SECONDS=604800
TRACEFANG_NATS_MAX_BYTES=10737418240
# 单条原始帧的 NATS 编码后上限（headers + body），默认 32 MiB。Compose 会把同一值
# 注入 nats-server.conf 的原生 max_payload；应用也会设置 stream max_msg_size 并在连接时
# 校验三者一致可承载。修改时必须同时重启 NATS；已有非空且上限更小的 stream 会拒绝启动，
# 请保全旧证据后改用新的 TRACEFANG_NATS_STREAM，不能在线破坏性改写。
TRACEFANG_NATS_MAX_FRAME_BYTES=33554432

# 上期所官网公开的黄金期权延时行情。无需 Token；默认启用且只允许官方 HTTPS 主机。
# 该数据不得标记为实时行情，逐合约 Delta 与月份 IV 为上一交易日参考值。
SHFE_GOLD_OPTIONS_ENABLED=true
SHFE_GOLD_OPTIONS_REQUEST_TIMEOUT_SECONDS=12
SHFE_GOLD_OPTIONS_CACHE_SECONDS=10

# PostgreSQL 是行情事实数据的主存储。首次运行 setup.cmd 时会在被 Git 忽略的
# .env.local 中生成本机专用随机密码和连接串；如使用外部 PostgreSQL，可在 .env
# 中显式填写下列连接串并跳过本地容器。
TRACEFANG_DATABASE_URL=
TRACEFANG_DB_MIN_POOL_SIZE=1
TRACEFANG_DB_MAX_POOL_SIZE=5
TRACEFANG_DB_COMMAND_TIMEOUT_SECONDS=10
