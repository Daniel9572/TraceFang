# 复制本文件为 .env 后填写本机值；.env 已被 Git 忽略，禁止提交真实 Token。
# PowerShell/系统进程环境变量优先于 .env 中的同名值。
JIN10_MCP_ENABLED=false
# 当前冻结 MCP：不初始化、不采集报价/K线、不补历史，也不参与校对。
JIN10_MCP_BEARER_TOKEN=
JIN10_MCP_URL=https://mcp.jin10.com/mcp
JIN10_MCP_TIMEOUT_SECONDS=20
# 以下额度字段只作冻结配置归档；当前不会启动 MCP 或调用任何工具。
JIN10_MCP_DAILY_TOOL_LIMIT=1500
JIN10_MCP_QUOTA_RESERVE=25
JIN10_MCP_QUOTA_TIMEZONE=Asia/Shanghai
JIN10_MCP_QUOTA_WARNING_PERCENT=80

# 金十官网公开结构化报价。0 表示按上游价格变化推送；不需要 Token 或桌面客户端。
JIN10_WEB_URL=wss://b-price.jin10.com/
JIN10_WEB_ORIGIN=https://www.jin10.com
JIN10_WEB_QUOTE_FREQUENCY_MS=0
JIN10_WEB_QUOTE_WAIT_TIMEOUT_SECONDS=5
JIN10_WEB_STALE_AFTER_SECONDS=12
JIN10_WEB_CONNECT_TIMEOUT_SECONDS=10

# 本地金十结构化报价。会话令牌属于密码凭据，只能填写在 .env/.env.local，禁止提交。
# JIN10_LOCAL_USER_ID 留空时，会从本机金十日志的登录记录中自动识别。
JIN10_LOCAL_SESSION_TOKEN=
JIN10_LOCAL_USER_ID=
JIN10_LOCAL_LOG_DIRECTORY=
JIN10_LOCAL_URL=wss://app-quote-ws.jin10.com/
JIN10_LOCAL_QUOTE_FREQUENCY_MS=1000
JIN10_LOCAL_QUOTE_WAIT_TIMEOUT_SECONDS=10
JIN10_LOCAL_STALE_AFTER_SECONDS=12
JIN10_LOCAL_CONNECT_TIMEOUT_SECONDS=10
JIN10_LOCAL_HEARTBEAT_SECONDS=10
JIN10_LOCAL_VIP_TYPE=3

# 可选。默认保存在项目 data/sources.json（该目录不会提交）。
MARKET_ANALYSIS_SOURCE_CONFIG=
MARKET_ANALYSIS_HOST=127.0.0.1
MARKET_ANALYSIS_PORT=8000

# PostgreSQL 是行情事实数据的主存储。首次运行 setup.cmd 时会在被 Git 忽略的
# .env.local 中生成本机专用随机密码和连接串；如使用外部 PostgreSQL，可在 .env
# 中显式填写下列连接串并跳过本地容器。
MARKET_ANALYSIS_DATABASE_URL=
MARKET_ANALYSIS_DB_MIN_POOL_SIZE=1
MARKET_ANALYSIS_DB_MAX_POOL_SIZE=5
MARKET_ANALYSIS_DB_COMMAND_TIMEOUT_SECONDS=10
